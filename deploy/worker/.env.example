# Configuración del Worker Server en AWS. Copiar a deploy/worker/.env (ignorado
# por git) o generarlo con deploy/aws/generar-env.sh. Sin secretos: la
# contraseña de la base la lee en-vm.sh de SSM al desplegar.

# --- Base de datos (RDS) -----------------------------------------------------
# El worker compone DATABASE_URL con estos valores y sslmode=require.
DB_HOST=mooc-bd.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=mooc
DB_NAME=mooc
DB_PASSWORD_SSM=/mooc/db/master-password
# Prefijo de los demás parámetros de SSM que en-vm.sh lee si existen
# (admin-password, badge-signing-key). Es "/<Proyecto>" de la pila.
SSM_PREFIJO=/mooc

# --- Redis -------------------------------------------------------------------
# IP privada de ESTA máquina (salida WorkerIpPrivada). Redis se publica solo en
# ella, no en 0.0.0.0: aunque la máquina no tiene IP pública, así tampoco
# escucha en interfaces que se añadan después.
REDIS_BIND_IP=10.20.1.10

# --- S3 ----------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=mooc-123456789012-us-east-1
# Vacías: instance profile. Ver deploy/web/.env.example.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# --- Procesamiento -----------------------------------------------------------
# Trabajos simultáneos. 2 y no el 5 local: en 2 GiB, dos FFmpeg o un FFmpeg y
# un LibreOffice ya rondan el límite. Es un parámetro del experimento de
# capacidad: debe quedar fijo en cada corrida y registrarse en el informe.
WORKER_CONCURRENCY=2

# --- Imágenes ----------------------------------------------------------------
IMAGEN_WORKER=mooc-worker:local
