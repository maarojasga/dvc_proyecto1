# Configuración del Web Server en AWS. Copiar a deploy/web/.env (ignorado por
# git) o generarlo con deploy/aws/generar-env.sh a partir de las salidas de la
# pila. No contiene secretos: la contraseña de la base la lee en-vm.sh de SSM
# Parameter Store al desplegar y nunca se escribe en disco.

# --- Base de datos (RDS) -----------------------------------------------------
# La API compone DATABASE_URL con estos valores y sslmode=require:
#   postgres://$DB_USER:$DB_PASSWORD@$DB_HOST:5432/$DB_NAME?sslmode=require
DB_HOST=mooc-bd.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_USER=mooc
DB_NAME=mooc
# Parámetro SecureString de SSM con la contraseña (salida ParametroPasswordBD).
DB_PASSWORD_SSM=/mooc/db/master-password
# Prefijo de los demás parámetros de SSM que en-vm.sh lee si existen
# (admin-password, badge-signing-key). Es "/<Proyecto>" de la pila.
SSM_PREFIJO=/mooc

# --- Redis (en el Worker Server) --------------------------------------------
# IP PRIVADA del Worker (salida WorkerIpPrivada). Sin contraseña: el acceso lo
# limita el security group del Worker al SG de esta máquina.
REDIS_ADDR=10.20.1.10:6379

# --- S3 ----------------------------------------------------------------------
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=mooc-123456789012-us-east-1
# Host con el que se firman las URLs que abre el navegador. En AWS es el mismo
# endpoint regional (resuelve igual dentro y fuera de la VPC).
S3_PUBLIC_ENDPOINT=s3.us-east-1.amazonaws.com
# Credenciales: VACÍAS a propósito. La API usa el instance profile de la EC2
# (LabInstanceProfile en Learner Lab), que rota solo. Definidas y vacías no es
# lo mismo que ausentes: ausentes, la API usaría la llave local de MinIO.
# Solo si no hay instance profile, pegar aquí las credenciales temporales del
# laboratorio (caducan en ~4 h, con su S3_SESSION_TOKEN).
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=

# --- Acceso público ----------------------------------------------------------
# Origen HTTPS (salida UrlPublica). Se usa en los enlaces de los correos y como
# origen permitido por CORS en la API; tiene que coincidir con el CORS del
# bucket, que la pila fija a este mismo origen.
PUBLIC_BASE_URL=https://203.0.113.10.sslip.io
# Nombre para el certificado (salida NombreHostWeb) y correo de aviso de
# Let's Encrypt (caducidad, incidentes). Ver deploy/web/certificado.sh.
TLS_HOST=203.0.113.10.sslip.io
TLS_EMAIL=

# --- Aplicación --------------------------------------------------------------
SMTP_FROM=no-reply@mooc.local
# Vacío = 10 intentos por IP y minuto, el valor de producción. Subirlo solo
# para una corrida de carga concreta, y registrarlo en el informe.
AUTH_RATE_LIMIT_PER_MINUTE=
BADGE_KEY_ID=mooc-badges-1
ISSUER_NAME=Plataforma MOOC
# Administrador inicial: se crea en el primer arranque si no existe ninguno.
# La contraseña NO va aquí: en-vm.sh la lee del parámetro /mooc/admin-password
# si existe. Retirar el correo tras el primer arranque.
ADMIN_EMAIL=
# BADGE_SIGNING_KEY tampoco va aquí: en-vm.sh la lee de /mooc/badge-signing-key.

# --- Imágenes ----------------------------------------------------------------
# Etiquetas cargadas por deploy/aws/construir-imagenes.sh. Si no existen en la
# máquina, compose las construye aquí (lento y con riesgo de quedarse sin
# memoria en 2 GiB).
IMAGEN_API=mooc-api:local
IMAGEN_MIGRATE=mooc-migrate:local
# Frontend existente, opcional: descomentar para levantarlo detrás de nginx.
# COMPOSE_PROFILES=frontend
