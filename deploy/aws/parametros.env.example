# Parámetros de la pila para deploy/aws/*.sh. Copiar a parametros.env (ignorado
# por git). Solo se envían a CloudFormation las variables NO vacías; las demás
# conservan el valor que ya tenga la pila (o el valor por defecto al crearla).
# Por eso aquí no aparecen CrearBaseDeDatos, SnapshotParaRestaurar ni
# HabilitarNatGateway: los cambian rds.sh y `desplegar-infra.sh Clave=Valor`,
# y fijarlos aquí los revertiría en cada despliegue.

PILA=mooc
# Learner Lab solo permite us-east-1 y us-west-2.
AWS_REGION=us-east-1

PROYECTO=mooc

# Learner Lab: sin roles propios, con el perfil existente del laboratorio.
CREAR_ROLES_PROPIOS=false
PERFIL_INSTANCIA=LabInstanceProfile

# Key pair existente (Learner Lab: vockey) y CIDR desde el que se permite SSH.
# Vacíos: solo SSM Session Manager.
NOMBRE_LLAVE_SSH=
CIDR_ADMINISTRACION=

TIPO_INSTANCIA=t3.small
CLASE_INSTANCIA_BD=db.t3.micro

# Dominio propio del Web Server. Vacío: <IP elástica>.sslip.io.
DOMINIO_WEB=

# Presupuesto con alertas por correo. Vacío: no se crea (Learner Lab no lo
# permite).
CORREO_ALERTAS_PRESUPUESTO=
PRESUPUESTO_MENSUAL_USD=40

# Correo para Let's Encrypt (generar-env.sh lo copia a TLS_EMAIL).
TLS_EMAIL=
