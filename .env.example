# Variables del entorno local orquestado por docker-compose.yml.
# Copiar a .env antes de levantar: cp .env.example .env

POSTGRES_DB=mooc
POSTGRES_USER=mooc
POSTGRES_PASSWORD=mooc

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=mooc

# Puertos del host para MinIO (9000/9001 suelen estar ocupados por otros proyectos)
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Origen publico del frontend (URLs de verificacion de insignias, metadatos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
