POSTGRES_DB=mooc
POSTGRES_USER=mooc
POSTGRES_PASSWORD=mooc

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=mooc

# Puertos del host para MinIO (9000/9001 suelen estar ocupados por otros proyectos)
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# Host por el que el NAVEGADOR alcanza el almacén de objetos. Por defecto se
# deriva de MINIO_API_PORT (localhost:9100), que es lo correcto en local.
# Importa porque la API habla con MinIO como "minio:9000", un nombre que solo
# resuelve dentro de la red del compose: una URL prefirmada contra ese host
# llega al navegador y muere con ERR_NAME_NOT_RESOLVED. La firma SigV4 cubre
# el Host, así que hay que firmar contra el host público, no reescribir la URL.
# En un despliegue real: el dominio del almacén o del CDN, con S3_PUBLIC_USE_SSL=true.
# S3_PUBLIC_ENDPOINT=localhost:9100
# S3_PUBLIC_USE_SSL=false

# Origen permitido por MinIO para las peticiones del navegador (subida
# prefirmada y lectura del HLS por hls.js). En producción, el origen real.
MINIO_CORS_ALLOW_ORIGIN=*

# Demonio ClamAV que escanea el material subido. El compose lo apunta a
# clamav:3310. Dejarla vacía hace que la API use el escáner de desarrollo, que
# solo reconoce EICAR y ejecutables; con APP_ENV=production el arranque falla
# en lugar de aceptar cargas sin escanear de verdad.
# ANTIMALWARE_ADDR=clamav:3310

# En local se salta la descarga de firmas del arranque (tarda minutos y la
# imagen ya trae una base). En un despliegue real va en false: una base de
# firmas vieja no protege.
CLAMAV_NO_FRESHCLAMD=true

# Colector de OpenTelemetry (OTLP/HTTP). El compose lo apunta a otel:4318.
# Vacía desactiva la exportación: sin colector, fallar el arranque por eso
# sería peor que no tener trazas. El propagador de contexto se instala
# siempre, así que la traza sigue cruzando de la API al worker.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel:4318

# Fracción de trazas que se conservan, de 0 a 1. Con 2.000 usuarios
# concurrentes, guardarlas todas cuesta más que lo que informan; para la prueba
# de carga conviene bajarlo (0.05 es un punto de partida razonable).
OTEL_TRACES_SAMPLER_ARG=1

# Puerto del host para el colector.
OTEL_HTTP_PORT=4318

# Redes desde las que se acepta X-Forwarded-For, en CIDR separados por comas.
# De esta dirección dependen el límite de tasa y la bitácora, así que la
# cabecera solo se cree si llega de un proxy declarado: si no, cualquiera
# podría rotar el valor y esquivar el límite por completo. Vacía es el lado
# seguro (se usa la dirección del socket). En el compose es la red interna.
TRUSTED_PROXIES=172.16.0.0/12

# URL pública del frontend, usada en enlaces de correo (verificación, reseteo)
# y como origen permitido por CORS.
PUBLIC_BASE_URL=http://localhost:3000

# Administrador inicial (opcional). Si se define, la API lo crea en el primer
# arranque si aún no existe ningún administrador. Retira estas variables tras
# el primer arranque en un entorno real.
ADMIN_EMAIL=
ADMIN_PASSWORD=
